    "## YOUR CODE TO LOAD/CLEAN/TIDY/WRANGLE THE DATA GOES HERE\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import ast\n",
    "df = pd.read_csv('data/00-raw/E_Commerce_Customer_Behavior_Dataset.csv')\n",
    "#The data is already tidy, every measurable variable has a separate column, every observation is in a different row\n",
    "#There is a unique identifier but it is wrong, the data is rectangular\n",
    "df['Customer ID'] = np.arange(len(df))\n",
    "size = df.size\n",
    "length = len(df)\n",
    "#Size of the dataset is 450, with 50 rows\n",
    "df.isnull().any()\n",
    "#There is no missing data at all\n",
    "df.dtypes\n",
    "#All data types are expected\n",
    "df['Purchase History'] = df['Purchase History'].apply(ast.literal_eval)\n",
    "\n",
    "df = df.explode('Purchase History')\n",
    "\n",
    "df = df.join(pd.json_normalize(df['Purchase History']))\n",
    "df.drop(columns=['Product Category', 'Purchase Date'], inplace=True)\n",
    "#Makes each purchase a separate column\n",
    "df.describe()\n",
    "#All min/max seem reasonable, no outliers seem to be present\n",
    "#Product Reviews seem to only apply for the first product, cannot be considered for other products\n",
    "categories = []\n",
    "\n",
    "for purchase in df['Purchase History']:\n",
    "    if isinstance(purchase, dict):\n",
    "        if 'Category' in purchase:\n",
    "            categories.append(purchase['Category'])\n",
    "        elif 'Product Category' in purchase:\n",
    "            categories.append(purchase['Product Category'])\n",
    "        else:\n",
    "            categories.append(np.nan)\n",
    "    else:\n",
    "        categories.append(np.nan)\n",
    "df['Category'] = categories   \n",
    "#Categories were mislabeled\n",
    "times = []\n",
    "for purchase in df['Purchase History']:\n",
    "    if isinstance(purchase, dict):\n",
    "        if 'Date' in purchase:\n",
    "            times.append(purchase['Date'])\n",
    "        elif 'Purchase Date' in purchase:\n",
    "            times.append(purchase['Purchase Date'])\n",
    "        else:\n",
    "            times.append(np.nan)\n",
    "    else:\n",
    "        times.append(np.nan)\n",
    "df['Date'] = times\n",
    "#Times were mislabeled\n",
    "df.to_csv('data/02-processed/E_Commerce_Customer_Behavior_Dataset_Cleaned.csv', index=False)"
   ]
